# Configuração pública do navegador. Copie para .env.local no desenvolvimento.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY
# Alternativa legada pública: VITE_SUPABASE_ANON_KEY. Não use chaves diferentes.
# A integração Vercel também pode fornecer SUPABASE_URL, SUPABASE_PUBLISHABLE_KEY
# e SUPABASE_ANON_KEY ou NEXT_PUBLIC_SUPABASE_URL/NEXT_PUBLIC_SUPABASE_ANON_KEY.
# O build expõe somente URL/chave pública; nunca uma chave administrativa.
# Canal público de suporte. Defina um endereço real antes de comercializar.
VITE_SUPPORT_EMAIL=

# Somente provisionamento/servidor: mantenha valores reais em arquivo protegido
# FORA do checkout ou nas configurações seguras da infraestrutura.
# Nunca prefixe com VITE_, publique em Git ou compartilhe pelo chat.
# A integração Vercel pode fornecer estas variáveis automaticamente.
SUPABASE_SERVICE_ROLE_KEY=
# Alternativa moderna à service_role, exclusiva do servidor:
# SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
# Aliases de conexão aceitos: POSTGRES_URL, POSTGRES_URL_NON_POOLING, DATABASE_URL.
# Alternativa à conexão direta para aplicar SQL pela API de administração:
SUPABASE_ACCESS_TOKEN=
# SUPABASE_PROJECT_REF=YOUR_PROJECT_REFERENCE
# O script já confia no CA público Supabase Root 2021 (scripts/certs/README.md).
# Substituição validada em caso de rotação do certificado do fornecedor:
# CLOSER_DB_CA_FILE=/caminho/fora/do/checkout/supabase-ca.crt
# Proprietário da plataforma; usado pelo provisionamento/build:cloud no servidor.
# O build normal NÃO envia o convite de ativação (--invite-owner é explícito).
CLOSER_OWNER_EMAIL=
CLOSER_APP_URL=https://closer-os-rho-three.vercel.app/
